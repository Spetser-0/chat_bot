# ─────────────────────────────────────────────
# Spetser AI — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
APP_DEBUG=true
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database (Supabase PostgreSQL) ───────────
DATABASE_URL=h
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spetser_dev

# ── Session ───────────────────────────────────
SESSION_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
SESSION_MAX_AGE_SECONDS=86400   # 24 hours

# ── Supabase Storage ──────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# ── AI Providers (store here, never in DB) ────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
GOOGLE_GEMINI_API_KEY=AIzaSy-CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME              # optional
QWEN_API_KEY=CHANGE_ME                   # optional
KIMI_API_KEY=CHANGE_ME                   # optional

# ── Developer Auth ────────────────────────────
DEVELOPER_EMAIL=dev@example.com
DEVELOPER_PASSWORD_HASH=CHANGE_ME        # bcrypt hash of your developer password

# ── Development Auth (ONLY for APP_ENV=development) ──
# WARNING: Never enable in production!
DEV_AUTH_ENABLED=false                   # Set to 'true' to enable dev bypass
DEV_AUTH_STUDENT_ID=                     # UUID of existing student for dev auth

# ── Rate Limits ───────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── Storage ───────────────────────────────────
STORAGE_BUCKET_DELIVERABLES=spetser-deliverables
STORAGE_TMP_DIR=/tmp/spetser

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json    # json | console
