# ─────────────────────────────────────────────
# Spetser AI — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32
APP_DEBUG=true
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ─────────────────────────────────
# Local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./spetser.db
# Production (PostgreSQL via Supabase):
# DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# ── Session ───────────────────────────────────
SESSION_SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32
SESSION_MAX_AGE_SECONDS=86400   # 24 hours
SESSION_COOKIE_SAMESITE=lax     # use none only with an explicit CSRF protection layer

# ── Supabase Storage ──────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# ── AI Providers (store here, never in DB) ────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
GOOGLE_GEMINI_API_KEY=AIzaSy-CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME              # optional
QWEN_API_KEY=CHANGE_ME                   # optional
KIMI_API_KEY=CHANGE_ME                   # optional

# ── Developer Auth ────────────────────────────
DEVELOPER_EMAIL=dev@example.com
DEVELOPER_PASSWORD_HASH=CHANGE_ME        # bcrypt hash of your developer password

# ── Development Auth (ONLY for APP_ENV=development) ──
# WARNING: Never enable in production!
DEV_AUTH_ENABLED=false                   # Set to 'true' to enable dev bypass
DEV_AUTH_STUDENT_ID=                     # UUID of existing student for dev auth

# ── JWT Tokens ────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption (Phase 2) ──────────────────────
# Master key used to encrypt/decrypt provider API keys at rest (Fernet).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key())"
# NEVER commit the real key.
LLM_MASTER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET

# ── Crypto Payments (Phase 2) ─────────────────
CRYPTO_PAYMENT_PROVIDER=nowpayments      # nowpayments | cryptomus
CRYPTO_PAYMENT_API_KEY=CHANGE_ME
CRYPTO_PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# ── Rate Limits ───────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
AUTH_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_DAY=200
ADMIN_RATE_LIMIT_PER_MINUTE=30
PAYMENTS_RATE_LIMIT_PER_MINUTE=10
# memory (default) | redis — redis requires REDIS_URL and the redis package
RATE_LIMIT_BACKEND=memory
# Used when RATE_LIMIT_BACKEND=redis (compose sets redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# ── Storage ───────────────────────────────────
STORAGE_BUCKET_DELIVERABLES=spetser-deliverables
STORAGE_TMP_DIR=/tmp/spetser

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json    # json | console
