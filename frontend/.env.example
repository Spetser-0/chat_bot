# ─────────────────────────────────────────────
# Spetser AI — Frontend Environment Variables
# Copy to frontend/.env.local for local overrides.
#
# VITE_API_BASE_URL is the backend ORIGIN only (no /api suffix).
# The client always requests `${API_BASE}/api/v1/...`.
# ─────────────────────────────────────────────

# Local dev without Vite proxy (optional; empty uses http://localhost:8000):
# VITE_API_BASE_URL=http://localhost:8000

# Production / Docker nginx: leave EMPTY so requests go same-origin
# (nginx proxies /api/ → backend:8000/api/):
# VITE_API_BASE_URL=
