# ─────────────────────────────────────────────
# Spetser AI — Root compose environment
# Copy to .env (repo root) and fill before `docker compose up`.
# NEVER commit .env.
# ─────────────────────────────────────────────

# Compose project name
COMPOSE_PROJECT_NAME=spetser

# Postgres (compose-managed)
POSTGRES_USER=spetser
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=spetser

# Application
APP_ENV=production
# Frontend at http://localhost:8080 (change for real domain)
APP_ALLOWED_ORIGINS=http://localhost:8080

# Rate limiting backend: redis (compose default) | memory
RATE_LIMIT_BACKEND=redis

# NOTE: backend/.env is also loaded by the backend container.
# It must contain APP_SECRET_KEY, SESSION_SECRET_KEY, LLM_MASTER_ENCRYPTION_KEY,
# and payment secrets. Copy backend/.env.example → backend/.env and fill it.
