# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.coverage
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Environment files — NEVER commit real secrets.
# .env.example is the only tracked variant (re-allowed at the end).
.env
.env.*
*.env.local
!.env.example

# Backup / swap files that often contain real secrets (.env.backup-*, .env.bak)
*.backup
*.backup-*
*.bak
*.orig
*.save
*~

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Database
*.sqlite
*.db
# خطأ لصق PowerShell — ملفات بلا امتداد من أوامر ملتصقة
*ExecutionPolicy*
*ScriptsActivate*
