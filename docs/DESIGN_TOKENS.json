{
  "$schema": "https://spetser.ai/schemas/design-tokens/v1",
  "name": "Spetser AI Design System",
  "version": "1.0.0",
  "documented_at": "2026-10-10",
  "source_of_truth": "frontend/src/index.css",
  "reference": {
    "name": "Perplexity AI",
    "url": "https://styles.refero.design/style/e9fff87a-63ce-4c19-840f-98233db62f58",
    "match": "16/17 specifications",
    "description": "Warm research terminal. Cream canvas, single teal accent, flat design, pill controls."
  },
  "deliberate_deviations": {
    "font_arabic": "Tajawal added - pplxSans does not support Arabic",
    "type_scale": "7 sizes instead of 3 - Arabic needs larger sizes for comfortable reading",
    "direction": "RTL - Arabic-first platform",
    "state_colors": "success/warning/error/info added for admin, payments, subscriptions"
  },
  "known_gap": {
    "token": "--content-max-width",
    "value": "640px",
    "status": "not_implemented",
    "note": "Reference centers main content at 640px; project has no max-width declared."
  },
  "tokens": {
    "--color-parchment": "#faf8f5",
    "--color-soft-paper": "#fdfbfa",
    "--color-warm-mist": "#d1d1cd",
    "--color-ash": "#92918b",
    "--color-graphite": "#72706b",
    "--color-ink": "#27251e",
    "--color-pure-black": "#000000",
    "--color-deep-teal": "#016a71",
    "--color-bg": "var(--color-parchment)",
    "--color-surface": "var(--color-soft-paper)",
    "--color-border": "var(--color-warm-mist)",
    "--color-text-primary": "var(--color-ink)",
    "--color-text-secondary": "var(--color-graphite)",
    "--color-text-muted": "var(--color-ash)",
    "--color-accent": "var(--color-deep-teal)",
    "--color-success": "#2d6a4f",
    "--color-success-bg": "#f0faf5",
    "--color-warning": "#92620a",
    "--color-warning-bg": "#fef9e7",
    "--color-error": "#9b2226",
    "--color-error-bg": "#fdf0f0",
    "--color-info": "#1a5276",
    "--color-info-bg": "#f0f5fc",
    "--font-arabic": "'Tajawal', system-ui, -apple-system, sans-serif",
    "--font-latin": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "--font-body": "var(--font-arabic)",
    "--text-xs": "0.75rem",
    "--text-sm": "0.875rem",
    "--text-base": "1rem",
    "--text-lg": "1.125rem",
    "--text-xl": "1.25rem",
    "--text-2xl": "1.5rem",
    "--text-3xl": "1.875rem",
    "--font-normal": "400",
    "--font-medium": "500",
    "--font-semibold": "600",
    "--leading-tight": "1.3",
    "--leading-normal": "1.6",
    "--leading-relaxed": "1.75",
    "--space-1": "0.25rem",
    "--space-2": "0.5rem",
    "--space-3": "0.75rem",
    "--space-4": "1rem",
    "--space-5": "1.25rem",
    "--space-6": "1.5rem",
    "--space-8": "2rem",
    "--space-10": "2.5rem",
    "--space-12": "3rem",
    "--space-16": "4rem",
    "--radius-sm": "6px",
    "--radius-md": "12px",
    "--radius-lg": "16px",
    "--radius-full": "9999px",
    "--shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.08)",
    "--shadow-md": "0 2px 8px rgba(0, 0, 0, 0.08)",
    "--shadow-focus": "0 0 0 3px rgba(1, 106, 113, 0.18)",
    "--sidebar-width": "260px",
    "--topbar-height": "56px",
    "--transition-fast": "120ms ease",
    "--transition-base": "200ms ease"
  },
  "token_count": 60
}